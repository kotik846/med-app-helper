{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/blog", "destination": "/blog.html" },
    { "source": "/studio", "destination": "/studio.html" },
    { "source": "/articles/:slug", "destination": "/blog.html?article=:slug" },
    { "source": "/api/v1/:path*", "destination": "https://blog-api-zeta-green.vercel.app/api/v1/:path*" }
  ]
}